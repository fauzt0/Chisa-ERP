# Directories: no directory listings, no execution, no direct access
# (mPDF usa uploads/tmp como tempDir; no debe ser servido por el navegador)
Options -Indexes -ExecCGI
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
